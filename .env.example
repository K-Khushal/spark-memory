# Local development. Copy to .env (never commit real values).
# Used by db:migrate, db:seed and the integration tests. `wrangler dev` reaches the
# same database through the Hyperdrive localConnectionString in apps/server/wrangler.jsonc.
# Sentry stays off locally; dev and prod DSNs are set in CI (docs/deploy.md).
DATABASE_URL=postgres://spark:spark@localhost:5432/spark
