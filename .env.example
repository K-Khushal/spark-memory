# Local development. Copy to .env (never commit real values).
# Used by db:migrate, db:seed and the integration tests. `wrangler dev` reaches the
# same database through the Hyperdrive localConnectionString in apps/server/wrangler.jsonc.
# Sentry stays off locally; dev and prod DSNs are set in CI (docs/deploy.md).
DATABASE_URL=postgres://spark:spark@localhost:5432/spark

# Auth (docs/deploy.md → Secrets and variables). Nothing to set locally:
# apps/server/wrangler.jsonc carries a throwaway BETTER_AUTH_SECRET and the
# Turnstile test keys, and sign-in codes go to the dev outbox. In dev and prod
# these are Worker secrets (`wrangler secret put`), never values in this file:
#   BETTER_AUTH_SECRET, BETTER_AUTH_URL (var)
#   TURNSTILE_SITE_KEY (var), TURNSTILE_SECRET_KEY
#   RESEND_API_KEY, EMAIL_FROM (var)
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET (optional)

# Memory files (docs/deploy.md → Memory files). Nothing to set locally: Miniflare
# simulates the R2 bucket and uploads go to the local Worker. In dev and prod:
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY (Worker secrets)
#   R2_BUCKET (var in wrangler.jsonc: spark-files-dev, spark-files-prod)

# Indexing (docs/deploy.md → Indexing). Nothing to set locally: Miniflare runs the
# queues and the fake provider (INDEXING_PROVIDER in wrangler.jsonc) needs no keys.
# In dev and prod: the AI binding and queues are in wrangler.jsonc, and
#   GEMINI_API_KEY (Worker secret, from a billed Cloud project only), with
#   GEMINI_PAID_TIER="true" (var in wrangler.jsonc) once billing is confirmed (ADR-0005)
