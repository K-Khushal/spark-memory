{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spark",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker serves the built dashboard and the API from one origin.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"],
  },
  "observability": { "enabled": true },

  // Top level = local `wrangler dev` only (never deployed; CI always passes --env).
  // Hyperdrive is bypassed locally: the Worker connects straight to Docker Postgres.
  // Override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
  // Local-only auth values: a throwaway secret and Cloudflare's always-pass
  // Turnstile test keys. Sign-in codes go to the dev outbox (no Resend).
  "vars": {
    "SPARK_ENV": "local",
    "INDEXING_PROVIDER": "fake",
    // Deep fetch answers from a script locally (src/deep-fetch.ts); no keys.
    "DEEP_FETCH_PROVIDER": "fake",
    "BETTER_AUTH_URL": "http://localhost:5173",
    "EXTENSION_ORIGIN": "chrome-extension://nibnigchkjjmpoolklhjgmlkancbmncm",
    "BETTER_AUTH_SECRET": "local-only-insecure-secret-never-deployed-0000",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
    // Local smoke test only. Dev and prod set ADMIN_EMAILS with wrangler secret put.
    "ADMIN_EMAILS": "admin@example.test",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local-only-not-a-real-hyperdrive-id",
      "localConnectionString": "postgres://spark:spark@localhost:5432/spark",
    },
  ],
  // Memory files. Locally Miniflare simulates the bucket (in .wrangler/state)
  // and, without R2 credentials, uploads go to /api/local-files on this Worker.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "spark-files-local" }],
  // Hourly: image uploads that never finished (src/sweep.ts), and Memories
  // whose Indexing message was lost (src/indexing.ts).
  "triggers": { "crons": ["17 * * * *"] },

  // Per signed-in person, per Cloudflare location, approximate (src/rate-limit.ts,
  // docs/research/rate-limits.md). Period is 10 or 60 seconds; namespace ids are unique per
  // account, so each environment has its own. Capture: 60 a minute (a Capture is two or
  // three calls). Search: 600 a minute, so instant search on every keystroke never trips it.
  // Edit (every other Library write): 60. AI opt-out: 10. Image search: 30.
  "ratelimits": [
    {
      "name": "CAPTURE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 },
    },
    {
      "name": "EDIT_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "OPT_OUT_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "IMAGE_SEARCH_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 30, "period": 60 },
    },
  ],

  // Indexing (src/indexing.ts). Queues have no priorities, so fresh Captures
  // and Retry get their own queue, consumed at once; background re-indexing
  // waits behind it (one consumer at a time, larger batches). After
  // max_retries the dead-letter queue marks the Memory Failed. Locally,
  // Miniflare runs the queues and the fake provider stands in for the AI
  // (no AI binding, no keys): INDEXING_PROVIDER in vars above.
  "queues": {
    "producers": [
      { "binding": "INDEX_QUEUE", "queue": "spark-index-local" },
      { "binding": "REINDEX_QUEUE", "queue": "spark-reindex-local" },
      { "binding": "IMPORT_QUEUE", "queue": "spark-import-local" },
      { "binding": "ACCOUNT_QUEUE", "queue": "spark-account-local" },
      { "binding": "DEEP_FETCH_QUEUE", "queue": "spark-deepfetch-local" },
    ],
    "consumers": [
      {
        "queue": "spark-index-local",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "spark-index-failed-local",
      },
      {
        "queue": "spark-reindex-local",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "spark-index-failed-local",
      },
      { "queue": "spark-index-failed-local", "max_batch_size": 10 },
      // Exports and account deletion (src/account-jobs.ts), one message per invocation.
      {
        "queue": "spark-import-local",
        "max_batch_size": 1,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "max_concurrency": 1,
      },
      {
        "queue": "spark-account-local",
        "max_batch_size": 1,
        "max_retries": 5,
      },
      // Deep fetch (src/deep-fetch.ts): one job per invocation (a video takes
      // minutes), two at a time so the free tiers are not burnt in a burst.
      {
        "queue": "spark-deepfetch-local",
        "max_batch_size": 1,
        "max_retries": 3,
        "max_concurrency": 2,
      },
    ],
  },

  // Bindings and vars do not inherit: repeat each one per environment.
  // Secrets per environment (`wrangler secret put <NAME> --env <name>`): SENTRY_DSN,
  // BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY, RESEND_API_KEY, and optionally
  // GOOGLE_CLIENT_ID/_SECRET and GITHUB_CLIENT_ID/_SECRET, R2_ACCOUNT_ID,
  // R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY, GEMINI_API_KEY (paid tier only),
  // ADMIN_EMAILS (comma-separated owner addresses), POSTHOG_KEY, and for Deep
  // fetch BROWSER_RENDERING_TOKEN and FETCHER_TOKEN.
  // See docs/deploy.md for creating the Hyperdrive configs and replacing the ids.
  "env": {
    "dev": {
      "vars": {
        "SPARK_ENV": "dev",
        "BETTER_AUTH_URL": "PLACEHOLDER_DEV_BETTER_AUTH_URL",
        "EXTENSION_ORIGIN": "",
        "TURNSTILE_SITE_KEY": "PLACEHOLDER_DEV_TURNSTILE_SITE_KEY",
        "EMAIL_FROM": "Spark <onboarding@resend.dev>",
        "R2_BUCKET": "spark-files-dev",
        // Deep fetch engines (docs/deploy.md): empty means Unavailable. The
        // tokens are secrets (BROWSER_RENDERING_TOKEN, FETCHER_TOKEN).
        "CLOUDFLARE_ACCOUNT_ID": "",
        "FETCHER_URL": "",
        // "true" only once GEMINI_API_KEY's Cloud project has billing on (ADR-0005).
        "GEMINI_PAID_TIER": "false",
      },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "PLACEHOLDER_DEV_HYPERDRIVE_ID" },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "spark-files-dev" }],
      // Per signed-in person, per Cloudflare location, approximate (src/rate-limit.ts,
      // docs/research/rate-limits.md). Period is 10 or 60 seconds; namespace ids are unique per
      // account, so each environment has its own. Capture: 60 a minute (a Capture is two or
      // three calls). Search: 600 a minute, so instant search on every keystroke never trips it.
      "ratelimits": [
        {
          "name": "CAPTURE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "SEARCH_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 600, "period": 60 },
        },
        {
          "name": "EDIT_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "OPT_OUT_LIMITER",
          "namespace_id": "2004",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "IMAGE_SEARCH_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "triggers": { "crons": ["17 * * * *"] },
      // Workers AI: Gemma 4, first in the Indexing chain (ADR-0005).
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [
          { "binding": "INDEX_QUEUE", "queue": "spark-index-dev" },
          { "binding": "REINDEX_QUEUE", "queue": "spark-reindex-dev" },
          { "binding": "IMPORT_QUEUE", "queue": "spark-import-dev" },
          { "binding": "ACCOUNT_QUEUE", "queue": "spark-account-dev" },
          { "binding": "DEEP_FETCH_QUEUE", "queue": "spark-deepfetch-dev" },
        ],
        "consumers": [
          {
            "queue": "spark-index-dev",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "dead_letter_queue": "spark-index-failed-dev",
          },
          {
            "queue": "spark-reindex-dev",
            "max_batch_size": 5,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "spark-index-failed-dev",
          },
          { "queue": "spark-index-failed-dev", "max_batch_size": 10 },
          // Exports and account deletion (src/account-jobs.ts), one message per invocation.
          {
            "queue": "spark-import-dev",
            "max_batch_size": 1,
            "max_batch_timeout": 30,
            "max_retries": 5,
            "max_concurrency": 1,
          },
          {
            "queue": "spark-account-dev",
            "max_batch_size": 1,
            "max_retries": 5,
          },
          // Deep fetch (src/deep-fetch.ts): one job per invocation (a video takes
          // minutes), two at a time so the free tiers are not burnt in a burst.
          {
            "queue": "spark-deepfetch-dev",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 2,
          },
        ],
      },
    },
    "production": {
      "vars": {
        "SPARK_ENV": "production",
        "BETTER_AUTH_URL": "PLACEHOLDER_PROD_BETTER_AUTH_URL",
        "EXTENSION_ORIGIN": "",
        "TURNSTILE_SITE_KEY": "PLACEHOLDER_PROD_TURNSTILE_SITE_KEY",
        "EMAIL_FROM": "Spark <onboarding@resend.dev>",
        "R2_BUCKET": "spark-files-prod",
        // Deep fetch engines (docs/deploy.md): empty means Unavailable. The
        // tokens are secrets (BROWSER_RENDERING_TOKEN, FETCHER_TOKEN).
        "CLOUDFLARE_ACCOUNT_ID": "",
        "FETCHER_URL": "",
        // "true" only once GEMINI_API_KEY's Cloud project has billing on (ADR-0005).
        "GEMINI_PAID_TIER": "false",
      },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "PLACEHOLDER_PROD_HYPERDRIVE_ID" },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "spark-files-prod" }],
      // Per signed-in person, per Cloudflare location, approximate (src/rate-limit.ts,
      // docs/research/rate-limits.md). Period is 10 or 60 seconds; namespace ids are unique per
      // account, so each environment has its own. Capture: 60 a minute (a Capture is two or
      // three calls). Search: 600 a minute, so instant search on every keystroke never trips it.
      "ratelimits": [
        {
          "name": "CAPTURE_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "SEARCH_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 600, "period": 60 },
        },
        {
          "name": "EDIT_LIMITER",
          "namespace_id": "3003",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "OPT_OUT_LIMITER",
          "namespace_id": "3004",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "IMAGE_SEARCH_LIMITER",
          "namespace_id": "3005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "triggers": { "crons": ["17 * * * *"] },
      // Workers AI: Gemma 4, first in the Indexing chain (ADR-0005).
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [
          { "binding": "INDEX_QUEUE", "queue": "spark-index-prod" },
          { "binding": "REINDEX_QUEUE", "queue": "spark-reindex-prod" },
          { "binding": "IMPORT_QUEUE", "queue": "spark-import-prod" },
          { "binding": "ACCOUNT_QUEUE", "queue": "spark-account-prod" },
          { "binding": "DEEP_FETCH_QUEUE", "queue": "spark-deepfetch-prod" },
        ],
        "consumers": [
          {
            "queue": "spark-index-prod",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "dead_letter_queue": "spark-index-failed-prod",
          },
          {
            "queue": "spark-reindex-prod",
            "max_batch_size": 5,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "spark-index-failed-prod",
          },
          { "queue": "spark-index-failed-prod", "max_batch_size": 10 },
          // Exports and account deletion (src/account-jobs.ts), one message per invocation.
          {
            "queue": "spark-import-prod",
            "max_batch_size": 1,
            "max_batch_timeout": 30,
            "max_retries": 5,
            "max_concurrency": 1,
          },
          {
            "queue": "spark-account-prod",
            "max_batch_size": 1,
            "max_retries": 5,
          },
          // Deep fetch (src/deep-fetch.ts): one job per invocation (a video takes
          // minutes), two at a time so the free tiers are not burnt in a burst.
          {
            "queue": "spark-deepfetch-prod",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 2,
          },
        ],
      },
    },
  },
}
