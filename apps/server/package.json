{
  "name": "@spark/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev --port ${SPARK_API_PORT:-8787} --var BETTER_AUTH_URL:http://localhost:${SPARK_WEB_PORT:-5173}",
    "build": "wrangler deploy --dry-run --env dev --outdir dist/dev && wrangler deploy --dry-run --env production --outdir dist/production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/cloudflare": "11.11.0",
    "@spark/auth": "workspace:*",
    "@spark/core": "workspace:*",
    "@spark/db": "workspace:*",
    "@spark/indexing": "workspace:*",
    "@spark/search": "workspace:*",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.19",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.0",
    "@spark/config": "workspace:*",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "wrangler": "^4.159.0"
  }
}
